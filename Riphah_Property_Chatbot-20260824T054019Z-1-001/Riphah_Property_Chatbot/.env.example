# Copy to .env and fill in. Never commit .env.

# --- OpenAI: chat, extraction, embeddings, voice ---
OPENAI_API_KEY=sk-proj-...

# --- Models (override only if you know why) ---
CHAT_MODEL=gpt-4.1
EXTRACT_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-large
EMBED_DIMENSIONS=1536
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
TRANSCRIBE_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts

CHAT_TEMPERATURE=0.3
EXTRACT_TEMPERATURE=0.0

# --- Outbound lead delivery ---
# Shared secret for HMAC-SHA256 webhook signatures. Must match WEBHOOK_SECRET in
# the CRM's .env. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# With no secret set, delivery is DISABLED rather than sent unsigned.
WEBHOOK_SECRET=
# Where lead.created / lead.updated are POSTed. The CRM's receiver:
LEAD_WEBHOOK_URL=http://127.0.0.1:8200/api/webhooks/riphah-chatbot

# --- Session lifecycle (minutes of silence) ---
IDLE_AFTER_MINUTES=5
INACTIVE_AFTER_MINUTES=30

# --- Abuse and cost control ---
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW_SECONDS=300

# --- Server ---
HOST=127.0.0.1
PORT=8100
DEFAULT_PORTAL=riphah-property
# Comma-separated origins allowed to embed the widget. "*" is dev only.
ALLOWED_ORIGINS=*

# --- web search fallback ------------------------------------------------------
# Used ONLY when the approved knowledge base returns nothing. Domain-limited on
# purpose: an open web search would let third-party listing sites and stale price
# rumours into the mouth of an assistant a buyer reads as the company.
WEB_SEARCH_ENABLED=1
WEB_SEARCH_DOMAINS=riphahmedicalcity.com,riphah.edu.pk,riphahproperties.com
WEB_SEARCH_MODEL=gpt-4.1
WEB_SEARCH_MAX_TOKENS=700
