# Copy to .env and fill in. Never commit .env.

# --- OpenAI: chat, extraction, embeddings, voice ---
OPENAI_API_KEY=sk-proj-...

# --- Models (override only if you know why) ---
CHAT_MODEL=gpt-4.1
EXTRACT_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-large
EMBED_DIMENSIONS=1536
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
TRANSCRIBE_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts

CHAT_TEMPERATURE=0.3
EXTRACT_TEMPERATURE=0.0

# --- Outbound lead delivery ---
# Shared secret for HMAC-SHA256 webhook signatures. Must match WEBHOOK_SECRET in
# the CRM's .env. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# With no secret set, delivery is DISABLED rather than sent unsigned.
WEBHOOK_SECRET=
# Where lead.created / lead.updated are POSTed. The CRM's receiver:
LEAD_WEBHOOK_URL=http://127.0.0.1:8200/api/webhooks/riphah-chatbot

# --- Session lifecycle (minutes of silence) ---
IDLE_AFTER_MINUTES=5
INACTIVE_AFTER_MINUTES=30

# --- Abuse and cost control ---
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW_SECONDS=300

# --- WhatsApp inbound (Meta Cloud API) ---
# See docs/WHATSAPP_INTEGRATION.md for where each value lives in the Meta dashboard.
# Our choice — any random string. Meta echoes it back when you save the webhook URL.
WHATSAPP_VERIFY_TOKEN=
# App → App settings → Basic → App secret. Verifies X-Hub-Signature-256 on every POST.
# With this unset the webhook rejects every message — no unverified inbound writes.
WHATSAPP_APP_SECRET=
# WhatsApp → API Setup. Sandbox token expires in 24 h; production uses a system-user token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Which portal's persona, fields and scoring a WhatsApp conversation uses.
WHATSAPP_PORTAL=riphah-property

# --- Model endpoint (optional) ---
# Leave empty for OpenAI. For a self-hosted OpenAI-compatible server (vLLM / Ollama
# serving Qwen): OPENAI_BASE_URL=http://127.0.0.1:8000/v1 and set CHAT_MODEL /
# EXTRACT_MODEL to the names that server exposes (e.g. Qwen2.5-14B-Instruct).
OPENAI_BASE_URL=

# --- Server ---
HOST=127.0.0.1
PORT=8100
DEFAULT_PORTAL=riphah-property
# Comma-separated origins allowed to embed the widget. "*" is dev only.
ALLOWED_ORIGINS=*

# --- web search fallback ------------------------------------------------------
# Used ONLY when the approved knowledge base returns nothing. Domain-limited on
# purpose: an open web search would let third-party listing sites and stale price
# rumours into the mouth of an assistant a buyer reads as the company.
WEB_SEARCH_ENABLED=1
WEB_SEARCH_DOMAINS=riphahmedicalcity.com,riphah.edu.pk,riphahproperties.com
WEB_SEARCH_MODEL=gpt-4.1
WEB_SEARCH_MAX_TOKENS=700
