# Copy to .env and fill in. Never commit .env.

# --- Chatbot integration ------------------------------------------------------
# MUST be byte-identical to WEBHOOK_SECRET in the chatbot's .env, or every
# inbound webhook is rejected with "signature mismatch".
WEBHOOK_SECRET=
WEBHOOK_MAX_AGE_SECONDS=300

CHATBOT_BASE_URL=http://127.0.0.1:8100
# Mint with: curl -X POST localhost:8100/api/admin/api-keys \
#   -H 'Content-Type: application/json' \
#   -d '{"label":"crm","scopes":["leads:read","leads:write"]}'
# (needs an admin cookie on the chatbot — see its README)
CHATBOT_API_KEY=

# Pull reconciliation. Push alone is not enough: a webhook lost while the CRM is
# restarting would never be recovered, and the CRM cannot know about a delivery it
# never received. The overlap window covers clock skew between the two services.
PULL_ENABLED=1
PULL_INTERVAL_SECONDS=300
PULL_OVERLAP_MINUTES=15

# --- Meta lead ads: PENDING ---------------------------------------------------
# The adapter, field mapping, scoring and webhook are built and tested against a
# fixture. These four values are the only thing outstanding — they come from
# Riphah marketing or their agency. Set them and the source flips to live with no
# code change.
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_PAGE_ID=

# --- Outbound comms: WhatsApp + SIP calling (PENDING) --------------------------
# Fully built: send/originate endpoints, UI buttons, activity logging and
# first-response tracking. Fill these and the buttons flip from fallback links
# (wa.me / softphone sip:) to real API calls with no code change.
#
# WhatsApp Business Cloud API — from the SAME Meta app as lead ads:
# developers.facebook.com → your app → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# SIP click-to-call — the HTTP originate endpoint of your PBX or trunk provider
# (Asterisk ARI, 3CX, FreePBX, Twilio, etc). The CRM POSTs
# {"to","caller_id","lead_ref","agent"} there with the bearer token.
SIP_ORIGINATE_URL=
SIP_ORIGINATE_TOKEN=
SIP_CALLER_ID=

# --- Staff auth ---------------------------------------------------------------
SESSION_TTL_DAYS=7
# First-run only: creates an admin when the staff table is empty. Change the
# password after the first login, then clear this.
BOOTSTRAP_ADMIN_EMAIL=admin@riphah.local
BOOTSTRAP_ADMIN_PASSWORD=

# --- SLA (provisional) --------------------------------------------------------
# Hot-lead response time and accountability are open items in the scope document
# (s13). These are placeholders the breach report measures against, and the UI
# labels them provisional.
SLA_HOT_HOURS=24
SLA_WARM_HOURS=72

# --- Analytics ----------------------------------------------------------------
DORMANT_AFTER_DAYS=14
DEFAULT_ANALYTICS_DAYS=30

# --- Server -------------------------------------------------------------------
HOST=127.0.0.1
PORT=8200
